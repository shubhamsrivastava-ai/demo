<%- include('partials/header') %>

<article class="product-detail" itemscope itemtype="https://schema.org/Product">
  <img src="<%= product.imageUrl %>" alt="<%= product.name %>" itemprop="image" />
  <div>
    <h1 itemprop="name"><%= product.name %></h1>
    <p class="price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
      <span itemprop="priceCurrency" content="USD">$</span><span itemprop="price"><%= product.price.toFixed(2) %></span>
    </p>
    <p itemprop="description"><%= product.description %></p>
    <p class="muted">Category: <%= product.category %></p>
    <form action="/cart/add/<%= product._id %>" method="POST" class="inline-form">
      <label for="quantity">Quantity</label>
      <input id="quantity" type="number" name="quantity" value="1" min="1" />
      <button type="submit" class="btn">Add to Cart</button>
    </form>
  </div>
</article>

<%- include('partials/footer') %>
