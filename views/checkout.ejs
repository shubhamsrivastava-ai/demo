<%- include('partials/header') %>

<section class="section checkout" aria-label="Checkout">
  <h1>Checkout</h1>
  <div class="checkout-grid">
    <div class="card">
      <h2>Order summary</h2>
      <div class="summary-row">
        <div>
          <p class="offer-restaurant"><%= offer.restaurant %></p>
          <strong><%= offer.item %></strong>
          <p class="muted">Pickup window: <%= offer.pickupWindow %></p>
        </div>
        <p class="price">₹<%= offer.price %></p>
      </div>
      <div class="summary-row">
        <span class="muted">Discount</span>
        <span class="badge"><%= offer.discount %></span>
      </div>
      <div class="summary-row total">
        <strong>Total</strong>
        <strong>₹<%= offer.price %></strong>
      </div>
    </div>

    <div class="card">
      <h2>Pickup instructions</h2>
      <ul class="instruction-list">
        <li>Arrive within <strong><%= offer.pickupWindow %></strong>.</li>
        <li>Carry your phone with the pickup code.</li>
        <li>Pickup only. No delivery available.</li>
      </ul>

      <h2>Payment method</h2>
      <div class="pill-group">
        <button class="pill active" type="button">UPI</button>
        <button class="pill" type="button">Card</button>
      </div>
    </div>
  </div>

  <div class="important-note">
    <strong>Important</strong>
    <p>This food is freshly prepared today and sold at a discounted price due to closing time. Pickup only.</p>
  </div>

  <div class="cta-row">
    <a class="btn" href="/order-confirmation">Pay Now</a>
  </div>
</section>

<nav class="bottom-nav" aria-label="Bottom navigation">
  <a href="/night">Home</a>
  <a class="active" href="/checkout">Checkout</a>
  <a href="/orders">Orders</a>
  <a href="/profile">Profile</a>
</nav>

<%- include('partials/footer') %>
