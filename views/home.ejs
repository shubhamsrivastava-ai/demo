<%- include('partials/header') %>

<section class="hero" aria-label="FreshFold introduction">
  <div class="hero-card">
    <p class="eyebrow">Logo + tagline</p>
    <h1>FreshFold</h1>
    <p class="hero-tagline">“Fresh food. Before it goes to waste.”</p>
    <div class="hero-cta locked" aria-live="polite">
      <span class="lock">🔒</span>
      <div>
        <p class="cta-label">Offers go live at 10:00 PM</p>
        <p class="cta-subtext">Check back tonight for verified surplus meals.</p>
      </div>
    </div>
  </div>
</section>

<section class="section" aria-label="How it works">
  <h2>Explainer</h2>
  <div class="explainer-grid">
    <article class="info-card">
      <h3>Night-time surplus food offers</h3>
      <p>Restaurants list the unsold, freshly prepared meals after closing time.</p>
    </article>
    <article class="info-card">
      <h3>Same-day fresh</h3>
      <p>Everything available tonight was prepared today and needs to be enjoyed now.</p>
    </article>
    <article class="info-card">
      <h3>Pickup only</h3>
      <p>No delivery confusion — arrive within the pickup window and show your code.</p>
    </article>
  </div>
</section>

<section class="section muted-panel" aria-label="Daytime notice">
  <div class="notice">
    <h2>Day time mode</h2>
    <p>Day time me koi food listing nahi dikhegi. Offers unlock only after 10:00 PM.</p>
  </div>
</section>

<nav class="bottom-nav" aria-label="Bottom navigation">
  <a class="active" href="/">Home</a>
  <a href="/orders">Orders</a>
  <a href="/profile">Profile</a>
</nav>

<%- include('partials/footer') %>
