<%- include('partials/header') %>

<section>
  <h1>Your Cart</h1>
  <% if (cart.length === 0) { %>
    <p>Your cart is empty. <a href="/">Continue shopping.</a></p>
  <% } else { %>
    <div class="cart-list">
      <% cart.forEach(item => { %>
        <article class="cart-item">
          <img src="<%= item.imageUrl %>" alt="<%= item.name %>" />
          <div>
            <h2><%= item.name %></h2>
            <p>$<%= item.price.toFixed(2) %></p>
            <form action="/cart/update/<%= item.productId %>" method="POST" class="inline-form">
              <label for="qty-<%= item.productId %>">Qty</label>
              <input id="qty-<%= item.productId %>" type="number" name="quantity" value="<%= item.quantity %>" min="1" />
              <button type="submit" class="btn btn-secondary">Update</button>
            </form>
            <form action="/cart/remove/<%= item.productId %>" method="POST">
              <button type="submit" class="link-btn">Remove</button>
            </form>
          </div>
          <p class="price">$<%= (item.quantity * item.price).toFixed(2) %></p>
        </article>
      <% }) %>
    </div>
    <aside class="cart-summary">
      <p>Subtotal: <strong>$<%= subtotal.toFixed(2) %></strong></p>
      <p>Shipping: <strong>$<%= shipping.toFixed(2) %></strong></p>
      <p>Total: <strong>$<%= total.toFixed(2) %></strong></p>
      <a href="/checkout" class="btn">Proceed to Checkout</a>
    </aside>
  <% } %>
</section>

<%- include('partials/footer') %>
